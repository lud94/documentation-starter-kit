# Prospector — variables d'environnement
#
# ⚠️ Ce fichier ne contient QUE des noms de variables. Aucune valeur, aucun secret.
# Copier en `.env.local` pour le développement, et poser les mêmes clés dans les
# réglages de chaque projet Vercel.

# ── Contrat d'environnement (lib/env.ts) ──────────────────────────────────────
# Identifiants NON SECRETS. Aucun repli implicite : une variable absente reste
# absente, elle ne vaut jamais « production ».

# development | staging | production — obligatoire hors poste local.
APP_ENV=

# production | staging — rôle du PROJET Vercel, déclaré par le projet lui-même.
# Vercel n'expose aucun nom de projet en variable système : il faut le déclarer.
APP_PROJECT_ROLE=

# Référence attendue du projet Supabase (le premier segment du hôte de SUPABASE_URL,
# par exemple `abcdefghijklmnop` dans https://abcdefghijklmnop.supabase.co).
# Non secret. Sert à vérifier que la base jointe est bien celle de cet environnement.
APP_SUPABASE_REF=

# Nom d'utilisateur attendu du bot Telegram (sans @). Non secret.
# Une divergence désactive le canal Telegram, sans bloquer l'application.
APP_TELEGRAM_BOT_USERNAME=

# Mettre à 1 une fois APP_ENV posé dans TOUS les environnements : l'absence de
# configuration devient alors bloquante pour les écritures, au lieu d'être un
# simple avertissement.
APP_ENV_STRICT=

# ── Supabase (obligatoire en persistance durable) ─────────────────────────────
# Ces deux variables ne peuvent pas vivre dans le keystore : c'est par elles qu'on
# joint la base qui contient le keystore.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Session ───────────────────────────────────────────────────────────────────
# Secret de signature des cookies de session.
APP_SESSION_SECRET=

# ── Envoi d'e-mail (réinitialisation de mot de passe) ─────────────────────────
RESEND_API_KEY=
RESET_FROM_EMAIL=

# ── Clés d'API métier ─────────────────────────────────────────────────────────
# Elles ne se posent PAS ici : elles se saisissent dans l'application
# (Admin → Connexions) et sont persistées dans le keystore, table
# prospector_settings. Les poser en variables d'environnement reste possible
# comme repli — le keystore est prioritaire.
#
#   ANTHROPIC_API_KEY, ANTHROPIC_BUDGET, EXA_API_KEY, PAPPERS_API_KEY,
#   UNIPILE_DSN, UNIPILE_API_KEY, UNIPILE_ACCOUNT_ID,
#   TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, TELEGRAM_BOT_NAME,
#   INGEST_TOKEN, SIGNALS_MODEL, JARVIS_MODEL, PLAN_MODEL, ENRICH_MODEL, WRITE_MODEL
