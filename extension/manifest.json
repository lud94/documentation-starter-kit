{
  "manifest_version": 3,
  "name": "Prospector — Ajouter un lead",
  "version": "1.0.0",
  "description": "Ajoute le profil LinkedIn courant dans Prospector en un clic.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ajouter à Prospector"
  }
}
