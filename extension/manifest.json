{
  "manifest_version": 3,
  "name": "Prospector — Jarvis",
  "version": "1.5.0",
  "description": "Ajoute un lead en 1 clic ET une barre Jarvis flottante pour piloter Prospector depuis n'importe quelle page.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://*/*"],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prospector — Jarvis",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
